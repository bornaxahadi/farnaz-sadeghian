      <button type="button" class="offer svc" data-type="3D design"><h3 data-i18n="s2"></h3><span data-i18n="s2t"></span><p data-i18n="s2d"></p><i class="enq" data-i18n="enq">Enquire</i></button>
      <button type="button" class="offer svc" data-type="Interior project"><h3 data-i18n="s3"></h3><span data-i18n="s3t"></span><p data-i18n="s3d"></p><i class="enq" data-i18n="enq">Enquire</i></button>
      </div>
