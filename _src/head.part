<!--HEADMETA-->
<!--FONTS-->
<meta name="theme-color" content="#561C24">
<link rel="preload" href="img/farnaz-hero.webp" as="image" fetchpriority="high">
<style>

/* Palette "Coffee" + Persian turquoise accent: #561C24 #6D2932 #C7B7A3 #E8D8C4 · #1C6E69 #23A399 #DCEDE8
   Layout: arched frames and linen bands, like walking room to room; one wine accent */
:root{
  --cream:#F5EDE2; --linen:#E8D8C4; --paper:#FBF7F1;
  --ink:#2B1517; --muted:#76605A; --line:#D9C9B5;
  --wine:#561C24; --wine-2:#6D2932; --sand:#C7B7A3;
  --teal:#1C6E69; --teal-2:#23A399; --mint:#DCEDE8; --pop:#F2A93B;
  --f-display:"Playfair Display","Didot",Georgia,serif;
  --f-script:"Pinyon Script","Snell Roundhand","Apple Chancery",cursive;
  --f-logo:"DM Serif Display","Playfair Display",Georgia,serif;
  --f-num:"DM Serif Display","Playfair Display",Georgia,serif;
  --f-body:"Outfit","Avenir Next","Segoe UI",system-ui,sans-serif;
  --f-fa:"Vazirmatn",Tahoma,sans-serif;
  --gutter:clamp(16px,4vw,48px); --max:1180px;
  color-scheme:light;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;scroll-padding-top:84px}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}
body{margin:0;background:var(--cream);color:var(--ink);font:300 17px/1.65 var(--f-body);-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{max-width:100%;height:auto;display:block}
a{color:inherit}
:focus-visible{outline:2px solid var(--wine);outline-offset:3px;border-radius:2px}
.wrap{max-width:var(--max);margin:0 auto;padding-inline:var(--gutter)}
.fa{font-family:var(--f-fa);direction:rtl;unicode-bidi:isolate}
.eyebrow{font:500 12px/1 var(--f-body);letter-spacing:.22em;text-transform:uppercase;color:var(--wine)}
h1,h2,h3{font-family:var(--f-display);font-weight:500;line-height:1.04;letter-spacing:-.01em;margin:0;text-wrap:balance;color:var(--ink)}
h2{font-size:clamp(36px,5vw,58px)}
h2 em,h1 em{font-family:var(--f-script);font-style:normal;font-weight:400;font-size:1.18em;line-height:.9;letter-spacing:0;color:var(--wine);padding-inline:.04em}
:root:lang(fa) h1 em,:root:lang(fa) h2 em,:root:lang(ar) h1 em,:root:lang(ar) h2 em,:root:lang(zh) h1 em,:root:lang(zh) h2 em,:root:lang(ja) h1 em,:root:lang(ja) h2 em{font-family:inherit;font-size:1em;font-style:normal}
p{margin:0}
.lead{font-size:clamp(17px,1.6vw,19px);color:var(--muted);max-width:56ch}
section{padding-block:clamp(72px,10vw,128px)}
.band{background:var(--linen)}
.btn{display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:999px;font:500 14px/1 var(--f-body);letter-spacing:.06em;text-decoration:none;border:1px solid var(--wine);transition:background .25s,color .25s,transform .25s;cursor:pointer}
.btn-solid{background:var(--wine);color:var(--paper)}
.btn-solid:hover{background:var(--wine-2)}
.btn-ghost{background:transparent;color:var(--wine)}
.btn-ghost:hover{background:var(--wine);color:var(--paper)}
.btn svg{width:18px;height:18px;flex:none}

/* nav */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb,var(--cream) 88%,transparent);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-bottom:1px solid transparent;transition:border-color .3s}
.nav.scrolled{border-color:var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;height:72px}
.logo{font:600 24px/1 var(--f-display);text-decoration:none;letter-spacing:.01em}
.logo i{color:var(--wine);font-weight:400}
.nav-links{display:flex;gap:28px;list-style:none;margin:0;padding:0}
.nav-links a{text-decoration:none;font-size:14px;letter-spacing:.06em;color:var(--muted)}
.nav-links a:hover{color:var(--wine)}
.nav .btn{padding:11px 18px;font-size:13px}
@media (max-width:860px){.nav-links{display:none}}

/* hero */
.hero{padding-block:clamp(28px,5vw,64px) clamp(64px,8vw,104px)}
.hero-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,6vw,88px);align-items:center}
.arch{position:relative;border-radius:999px 999px 18px 18px;overflow:hidden;background:var(--linen);aspect-ratio:3/4;max-width:100%}
.arch img{width:100%;height:100%;object-fit:cover}
.hero .arch{box-shadow:0 30px 60px -30px rgba(70,30,25,.35)}
.hero .arch img{object-position:22% 60%;animation:settle 1.6s cubic-bezier(.2,.7,.2,1) both}
@keyframes settle{from{transform:scale(1.06)}to{transform:scale(1)}}
.hero-photo{position:relative}
.hero-photo .tag{position:absolute;left:-10px;bottom:28px;background:var(--paper);padding:14px 18px;border-radius:14px;box-shadow:0 14px 30px -18px rgba(70,30,25,.45);display:flex;align-items:center;gap:12px;font-size:13px;line-height:1.3}
.tag .dot{width:9px;height:9px;border-radius:50%;background:#2F8F5B;box-shadow:0 0 0 0 rgba(47,143,91,.5);animation:pulse 2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 9px rgba(47,143,91,0)}100%{box-shadow:0 0 0 0 rgba(47,143,91,0)}}
.tag b{font:400 18px/1.1 var(--f-num);display:block;font-variant-numeric:tabular-nums}
.hero h1{font-size:clamp(48px,7.2vw,104px);letter-spacing:-.02em;margin-block:18px 22px}
.hero .fa-line{font-size:18px;color:var(--wine);margin-bottom:18px;display:block;text-align:left}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.creds{display:flex;flex-wrap:wrap;gap:10px 22px;margin-top:40px;padding-top:24px;border-top:1px solid var(--line);font-size:14px;color:var(--muted)}
.creds span{display:flex;align-items:center;gap:8px}
.creds span::before{content:"";width:5px;height:5px;transform:rotate(45deg);background:var(--sand)}
@media (max-width:820px){.hero-grid{grid-template-columns:1fr}.hero-photo{max-width:440px;margin-inline:auto;width:100%}.hero-photo .tag{left:8px}}

/* stats */
.stats-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:20px;margin-bottom:44px}
.live{display:inline-flex;align-items:center;gap:8px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted)}
.platforms{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.pcard{background:var(--paper);border-radius:22px;padding:clamp(24px,3vw,36px);display:grid;gap:18px;border:1px solid var(--line)}
.pcard-top{display:flex;justify-content:space-between;align-items:center;gap:12px}
.handle{display:flex;align-items:center;gap:12px;font-weight:400;text-decoration:none}
.handle svg{width:30px;height:30px;color:var(--wine)}
.verified{display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--muted)}
.verified svg{width:15px;height:15px;color:#3B82D6}
.count{font:400 clamp(60px,8vw,96px)/1 var(--f-num);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
.count-label{font-size:13px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.gain{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:14px;color:var(--muted);padding-top:16px;border-top:1px dashed var(--line)}
.gain b{color:var(--ink);font:400 16px/1 var(--f-num);font-variant-numeric:tabular-nums}
.gain .up{color:#2F7A50}
.reach{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;background:var(--line);border-radius:22px;overflow:hidden;margin-top:20px;border:1px solid var(--line)}
.reach div{background:var(--linen);padding:26px 24px}
.band .reach div{background:var(--cream)}
.reach b{display:block;font:400 clamp(40px,4.6vw,58px)/1 var(--f-num);color:var(--wine);font-variant-numeric:tabular-nums}
.reach span{font-size:13px;color:var(--muted);display:block;margin-top:8px;line-height:1.4}
.note{font-size:12px;color:var(--muted);margin-top:14px}
@media (max-width:820px){.platforms{grid-template-columns:1fr}.reach{grid-template-columns:repeat(2,minmax(0,1fr))}}

/* about */
.about-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.15fr);gap:clamp(32px,6vw,90px);align-items:center}
.about-photos{position:relative;padding-bottom:70px}
.about-photos .arch{width:78%}
.about-photos .arch img{object-position:50% 20%}
.about-photos .small{position:absolute;right:0;bottom:0;width:48%;border-radius:16px;overflow:hidden;border:8px solid var(--cream);box-shadow:0 20px 40px -24px rgba(70,30,25,.5)}
.about-photos .small img{aspect-ratio:4/5;object-fit:cover;object-position:60% 50%}
.about-copy{display:grid;gap:22px}
.about-copy p{max-width:58ch}
.script{font:italic 400 clamp(24px,2.6vw,30px)/1.4 var(--f-display);color:var(--wine)}
.facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;border-top:1px solid var(--line);margin-top:8px}
.facts div{padding:18px 0;border-bottom:1px solid var(--line)}
.facts div:nth-child(odd){padding-right:18px}
.facts b{display:block;font:400 36px/1.05 var(--f-num);color:var(--wine)}
.facts span{font-size:14px;color:var(--muted)}
@media (max-width:820px){.about-grid{grid-template-columns:1fr}.about-photos{max-width:460px;margin-inline:auto;width:100%}}

/* before / after */
.ba-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.4fr);gap:clamp(28px,5vw,72px);align-items:center}
.ba{position:relative;border-radius:22px;overflow:hidden;aspect-ratio:8/5;background:var(--paper);user-select:none;touch-action:pan-y;box-shadow:0 30px 60px -36px rgba(70,30,25,.45)}
.ba svg{position:absolute;inset:0;width:100%;height:100%}
.ba .before{clip-path:inset(0 calc(100% - var(--pos,50%)) 0 0)}
.ba .handle-line{position:absolute;top:0;bottom:0;left:var(--pos,50%);width:2px;margin-left:-1px;background:var(--paper);pointer-events:none}
.ba .knob{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:48px;height:48px;border-radius:50%;background:var(--paper);display:grid;place-items:center;box-shadow:0 6px 18px rgba(40,20,15,.3);color:var(--wine)}
.ba .knob svg{position:static;width:22px;height:22px}
.ba .lbl{position:absolute;top:16px;padding:7px 12px;border-radius:999px;background:rgba(251,248,244,.9);font-size:11px;letter-spacing:.18em;text-transform:uppercase;pointer-events:none}
.ba .lbl.l{left:16px}.ba .lbl.r{right:16px;color:var(--wine)}
.ba input{position:absolute;inset:0;width:100%;height:100%;opacity:0;cursor:ew-resize;margin:0}
.ba-tabs{display:flex;gap:8px;margin-top:18px;flex-wrap:wrap}
.chip{border:1px solid var(--line);background:transparent;border-radius:999px;padding:9px 16px;font:400 13px/1 var(--f-body);color:var(--muted);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--ink);color:var(--paper);border-color:var(--ink)}
.steps{list-style:none;padding:0;margin:26px 0 0;display:grid;gap:14px}
.steps li{display:grid;grid-template-columns:28px 1fr;gap:12px;font-size:15.5px}
.steps li b{font:italic 500 22px/1 var(--f-display);color:var(--wine)}
@media (max-width:900px){.ba-grid{grid-template-columns:1fr}}

/* learn */
.learn-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:24px;align-items:end;margin-bottom:48px}
.topics{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.topic{background:var(--paper);border:1px solid var(--line);border-radius:999px 999px 16px 16px;padding:44px 20px 24px;text-align:center;display:grid;gap:8px;transition:transform .3s,border-color .3s}
.topic:hover{transform:translateY(-4px);border-color:var(--sand)}
.topic svg{width:40px;height:40px;margin:0 auto 6px;color:var(--wine)}
.topic h3{font-size:24px}
.topic .fa{font-size:14px;color:var(--wine)}
.topic p{font-size:14px;color:var(--muted);line-height:1.5}
@media (max-width:980px){.topics{grid-template-columns:repeat(2,minmax(0,1fr))}.learn-head{grid-template-columns:1fr}}
@media (max-width:440px){.topics{grid-template-columns:1fr}.topic{border-radius:140px 140px 16px 16px;padding-top:32px}}

/* reels */
.reels{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:44px}
.reel{position:relative;display:grid;align-content:space-between;gap:28px;min-height:230px;padding:26px;border-radius:20px;text-decoration:none;background:var(--paper);border:1px solid var(--line);overflow:hidden;transition:transform .3s}
.reel:hover{transform:translateY(-4px)}
.reel.feature{background:var(--wine);color:var(--paper);border-color:var(--wine)}
.reel.feature .muted,.reel.feature .fa{color:#E8CFC5}
.reel .views{font:400 clamp(48px,5.5vw,68px)/1 var(--f-num);font-variant-numeric:tabular-nums}
.reel .views small{font:400 13px var(--f-body);letter-spacing:.14em;text-transform:uppercase;margin-left:6px}
.reel h3{font-size:24px;color:inherit}
.reel .fa{font-size:15px;color:var(--wine);display:block;margin-top:6px}
.reel .muted{font-size:13px;color:var(--muted)}
.reel .play{position:absolute;right:22px;top:22px;width:38px;height:38px;border-radius:50%;border:1px solid currentColor;display:grid;place-items:center;opacity:.6}
.reel .play svg{width:14px;height:14px}
@media (max-width:900px){.reels{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.reels{grid-template-columns:1fr}}

/* work with */
.collab-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(28px,5vw,72px)}
.offers{display:grid;gap:0;border-top:1px solid var(--line)}
.offer{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 18px;padding:22px 0;border-bottom:1px solid var(--line)}
.offer h3{font-size:26px}
.offer p{grid-column:1/-1;font-size:15px;color:var(--muted)}
.offer span{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--wine);align-self:center}
.partners{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
.partners span{border:1px solid var(--line);border-radius:999px;padding:7px 14px;font-size:13px;color:var(--muted)}
.book{margin-top:28px;background:var(--ink);color:var(--paper);border-radius:22px;padding:30px;display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center}
.book .cover{width:74px;aspect-ratio:2/3;background:var(--wine);border-radius:3px 8px 8px 3px;box-shadow:inset 6px 0 0 rgba(0,0,0,.25),0 10px 20px -8px rgba(0,0,0,.5);display:grid;place-items:center;font:italic 500 13px/1.1 var(--f-display);text-align:center;color:#EAD5C8;padding:6px}
.book h3{color:var(--paper);font-size:26px}
.book p{color:#CDBFB3;font-size:14.5px;margin-top:6px}
@media (max-width:820px){.collab-grid{grid-template-columns:1fr}}

/* contact */
.contact{background:var(--wine);color:var(--paper)}
.contact h2,.contact .eyebrow{color:var(--paper)}
.contact h2 em{color:#E7C3B4}
.contact .lead{color:#E3CFC6}
.contact-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);gap:clamp(28px,5vw,72px);align-items:start}
.channels{display:grid;gap:12px;margin-top:32px}
.channel{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:14px;padding:16px 18px;border:1px solid rgba(255,255,255,.18);border-radius:16px;text-decoration:none;color:var(--paper);transition:background .25s}
.channel:hover{background:rgba(255,255,255,.07)}
.channel svg{width:22px;height:22px}
.channel .ic{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.1);display:grid;place-items:center}
.channel small{display:block;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#D9BFB4}
.channel b{font-weight:400;word-break:break-word}
.copy{background:none;border:1px solid rgba(255,255,255,.3);color:var(--paper);border-radius:999px;padding:6px 12px;font:400 12px var(--f-body);cursor:pointer}
form{background:var(--paper);color:var(--ink);border-radius:24px;padding:clamp(24px,3.5vw,40px);display:grid;gap:16px}
form h3{font-size:30px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
label{display:grid;gap:6px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
input,select,textarea{font:400 16px/1.4 var(--f-body);color:var(--ink);background:var(--cream);border:1px solid var(--line);border-radius:12px;padding:13px 14px;width:100%;letter-spacing:0;text-transform:none}
input:focus,select:focus,textarea:focus{outline:none;border-color:var(--wine);box-shadow:0 0 0 3px rgba(86,28,36,.12)}
textarea{min-height:120px;resize:vertical}
.err{color:var(--wine);font-size:13px;min-height:1em}
.sent{display:grid;gap:14px;text-align:left}
.sent pre{white-space:pre-wrap;font:400 14px/1.5 var(--f-body);background:var(--cream);border-radius:12px;padding:14px;margin:0;max-height:180px;overflow:auto}
.sent .acts{display:flex;flex-wrap:wrap;gap:10px}
@media (max-width:860px){.contact-grid{grid-template-columns:1fr}}
@media (max-width:520px){.row{grid-template-columns:1fr}}

footer{padding-block:36px;font-size:13px;color:var(--muted)}
footer .wrap{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center}
footer a{text-decoration:none}
.float-wa{position:fixed;right:18px;bottom:calc(18px + env(safe-area-inset-bottom,0px));z-index:30;width:56px;height:56px;border-radius:50%;background:#1F7A4D;color:#fff;display:grid;place-items:center;box-shadow:0 12px 26px -10px rgba(0,0,0,.45);transition:transform .25s}
.float-wa:hover{transform:scale(1.06)}
.float-wa svg{width:28px;height:28px}

.reveal{transition:opacity .9s ease,transform .9s ease}
.js .reveal.pending{opacity:.001;transform:translateY(24px)}

/* language menu */
.nav-right{display:flex;align-items:center;gap:10px}
.lang{position:relative}
.lang-btn{display:flex;align-items:center;gap:8px;background:transparent;border:1px solid var(--line);border-radius:999px;padding:8px 12px;font:400 13px/1 var(--f-body);color:var(--ink);cursor:pointer}
.lang-btn:hover{border-color:var(--sand)}
.flag{width:22px;height:15px;border-radius:3px;overflow:hidden;flex:none;box-shadow:0 0 0 1px rgba(0,0,0,.08)}
.lang-menu{position:absolute;right:0;top:calc(100% + 8px);background:var(--paper);border:1px solid var(--line);border-radius:16px;padding:6px;list-style:none;margin:0;min-width:190px;box-shadow:0 20px 40px -20px rgba(70,30,25,.4);z-index:40}
[dir="rtl"] .lang-menu{right:auto;left:0}
.lang-menu a,.lang-menu button{text-decoration:none;box-sizing:border-box;display:flex;align-items:center;gap:12px;width:100%;background:none;border:0;border-radius:10px;padding:10px 12px;font:400 14px/1 var(--f-body);color:var(--ink);cursor:pointer;text-align:start}
.lang-menu a:hover,.lang-menu a[aria-current="true"],.lang-menu button:hover,.lang-menu button[aria-current="true"]{background:var(--linen)}
.lang-menu a[aria-current="true"]::after,.lang-menu button[aria-current="true"]::after{content:"";margin-inline-start:auto;width:6px;height:6px;border-radius:50%;background:var(--wine)}
@media (max-width:520px){.nav .btn{display:none}.logo{font-size:22px}}
/* script-specific type */
:root:lang(fa),:root:lang(ar){--f-display:"Vazirmatn",Tahoma,sans-serif;--f-body:"Vazirmatn",Tahoma,sans-serif}
:root:lang(fa) h1,:root:lang(ar) h1,:root:lang(fa) h2,:root:lang(ar) h2{font-weight:600;line-height:1.3}
:root:lang(fa) h1,:root:lang(ar) h1{font-size:clamp(38px,5.6vw,72px)}
:root:lang(fa) .script,:root:lang(ar) .script{font-style:normal;font-size:clamp(20px,2.4vw,26px);line-height:1.6}
:root:lang(zh),:root:lang(ja){--f-display:"Noto Serif SC","Noto Serif JP","Songti SC","Hiragino Mincho ProN","Yu Mincho",serif;--f-body:"PingFang SC","Hiragino Sans","Noto Sans SC","Noto Sans JP","Microsoft YaHei",system-ui,sans-serif}
:root:lang(zh) h1,:root:lang(ja) h1{font-size:clamp(38px,5.6vw,72px);line-height:1.2}
:root:lang(zh) .eyebrow,:root:lang(ja) .eyebrow,:root:lang(fa) .eyebrow,:root:lang(ar) .eyebrow{letter-spacing:.06em}
:root:lang(fa) .fa-accent{display:none}
[dir="rtl"] .hero .fa-line{text-align:right}
[dir="rtl"] .hero-photo .tag{left:auto;right:-10px}
@media (max-width:820px){[dir="rtl"] .hero-photo .tag{right:8px}}
[dir="rtl"] .about-photos .small{right:auto;left:0}
[dir="rtl"] .facts div:nth-child(odd){padding-right:0;padding-left:18px}
[dir="rtl"] .float-wa{right:auto;left:18px}
[dir="rtl"] .btn svg use[href="#i-arrow"],[dir="rtl"] .channel > svg{transform:scaleX(-1)}
[dir="rtl"] .reel .play{right:auto;left:22px}

/* brand band with the 3D room logo */
.brand-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,.95fr);gap:clamp(24px,5vw,72px);align-items:center}
.brand-grid .room3d{--ink:#2B1517;--wine:#561C24}
.brand-copy{display:grid;gap:18px}
.room3d[dir]{direction:ltr}
@media (max-width:860px){.brand-grid{grid-template-columns:1fr}.brand-grid .room3d{max-width:420px}}

/* Third Skin brand */
.logo{display:inline-flex;align-items:center;gap:12px;color:var(--wine)}
.logo .mark{width:50px;height:40px;flex:none;object-fit:contain}
.logo .lw{display:flex;flex-direction:column;line-height:1}
.logo .lw b{font:400 24px/1 var(--f-logo);letter-spacing:.05em;text-transform:uppercase;color:var(--wine)}
.logo .lw small{font:600 10px/1 var(--f-body);letter-spacing:.5em;text-transform:uppercase;color:var(--ink);margin-top:5px}
.quote{margin:10px 0 0;padding:26px 0 0 28px;border-left:2px solid var(--wine);display:grid;gap:12px}
[dir="rtl"] .quote{border-left:0;border-right:2px solid var(--wine);padding:26px 28px 0 0}
.quote blockquote{margin:0;font:italic 400 clamp(22px,2.4vw,30px)/1.45 var(--f-display);color:var(--ink)}
.quote figcaption{font-size:13px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
:root:lang(fa) .quote blockquote,:root:lang(ar) .quote blockquote{font-style:normal}

.contact-logo{display:block;width:clamp(170px,18vw,220px);height:auto;margin-bottom:28px}
.foot-logo{display:block;width:min(300px,100%);height:auto}

/* hero: headline written on the wall she points at */
.hero-wall{padding:0;--H:clamp(620px,88vh,900px);background:linear-gradient(to bottom,#BCB5A7 0,#C1BAAC 45%,#AA9F91 85.9%,#DCD5C6 85.9%);overflow:hidden}
.hero-stage{position:relative;max-width:1440px;margin:0 auto;height:var(--H)}
.hero-img{position:absolute;left:0;top:0;height:100%;aspect-ratio:3/4;background:url(img/farnaz-hero.webp) left top/100% 100% no-repeat;-webkit-mask-image:linear-gradient(to right,#000 72%,transparent 100%);mask-image:linear-gradient(to right,#000 72%,transparent 100%)}
.hero-wall::before{content:"";position:absolute;inset:0;pointer-events:none}
.hero-text{position:absolute;left:calc(var(--H)*.88 + 24px);right:var(--gutter);top:13%;max-width:620px;color:var(--ink)}
.hero-wall .eyebrow{color:var(--ink)}
.hero-wall h1{font-size:clamp(52px,6.4vw,104px);margin-block:16px 18px;color:#1E1214}
.hero-wall h1 em{color:var(--wine)}
.hero-wall .lead{color:#2B2223;max-width:52ch}
.hero-wall .fa-line{color:var(--wine)}
.hero-wall .creds{border-top-color:rgba(43,21,23,.25);color:#2B2223}
.hero-wall .creds span::before{background:var(--teal-2)}
.hero-wall .btn-ghost{color:var(--ink);border-color:var(--ink)}
.hero-wall .btn-ghost:hover{background:var(--ink);color:var(--paper)}
.hero-wall .tag{position:absolute;left:var(--gutter);bottom:4%;z-index:2;background:var(--paper);padding:14px 18px;border-radius:14px;box-shadow:0 14px 30px -18px rgba(70,30,25,.45);display:flex;align-items:center;gap:12px;font-size:13px;line-height:1.3}

@media (max-width:1180px){.hero-text{left:calc(var(--H)*.78 + 16px);top:9%}.hero-wall h1{font-size:clamp(42px,5.2vw,70px)}.hero-wall .lead{font-size:16px}}
@media (max-width:860px){
  .hero-wall{--H:auto;background:var(--cream)}
  .hero-stage{height:auto;display:flex;flex-direction:column}
  .hero-img{position:relative;width:100%;height:auto;aspect-ratio:3/4;max-height:78vh;background-size:cover;background-position:30% 40%;-webkit-mask-image:none;mask-image:none}
  .hero-wall .tag{bottom:auto;top:calc(min(78vh,133vw) - 86px)}
  .hero-text{position:static;padding:28px var(--gutter) 56px;max-width:none}
  .hero-wall h1{font-size:clamp(42px,11vw,64px)}
}

.studio-logo{display:block;width:min(420px,80%);height:auto;margin-inline:auto}


/* Persian turquoise accents, used sparingly */
.eyebrow{color:var(--teal)}
.hero-wall .eyebrow{color:var(--teal)}
.creds span::before,.hero-wall .creds span::before{background:var(--teal-2)}
.tag .dot{background:var(--teal-2);box-shadow:0 0 0 0 rgba(35,163,153,.5)}
.live .dot{background:var(--teal-2)!important}
.gain .up{color:var(--teal)}
.verified svg{color:var(--teal-2)}
.topic svg{color:var(--teal)}
.topic:nth-child(even){background:linear-gradient(180deg,var(--mint),var(--paper) 70%)}
.topic:hover{border-color:var(--teal-2)}
.reels .reel:nth-child(2){background:var(--teal);color:var(--paper);border-color:var(--teal)}
.reels .reel:nth-child(2) .fa,.reels .reel:nth-child(2) .muted{color:#CDEBE6}
.steps li b{color:var(--teal)}
.quote{border-left-color:var(--teal-2)}
[dir="rtl"] .quote{border-right-color:var(--teal-2)}
.chip[aria-pressed="true"]{background:var(--teal);border-color:var(--teal)}
.reach div:nth-child(2) b,.reach div:nth-child(4) b{color:var(--teal)}
.partners span:nth-child(3n+1){border-color:var(--teal-2);color:var(--teal)}
.book .cover{background:linear-gradient(160deg,var(--teal),#0F4643)}
.offer span{color:var(--teal)}
.contact .eyebrow{color:#8FD8CF}
.channel .ic{background:rgba(35,163,153,.22)}
.float-wa{background:var(--teal-2)}
.btn-ghost:hover{background:var(--teal);border-color:var(--teal);color:var(--paper)}

/* bright saffron pop, very occasional */
h2 em{background:linear-gradient(transparent 78%,rgba(242,169,59,.55) 78% 90%,transparent 90%);padding:0 .08em}
:root:lang(fa) h2 em,:root:lang(ar) h2 em,:root:lang(zh) h2 em,:root:lang(ja) h2 em{background:none}
.reels .reel:nth-child(2) .play{border-color:var(--pop);color:var(--pop)}
.reach div:nth-child(3) b{color:#C7801A}
.tag{box-shadow:0 0 0 3px rgba(242,169,59,.0)}
.btn-primary:hover{box-shadow:0 0 0 3px var(--pop)}

/* ===== hero v10: turquoise arch behind Farnaz, parallax, animated room logo ===== */
.fa-accent{display:none!important}
.hero-img{overflow:hidden}
.hero-arch{position:absolute;left:11%;width:36%;top:25%;bottom:14.1%;border-radius:999px 999px 0 0;
  background:radial-gradient(120% 70% at 50% 18%,#2FB3A8 0,var(--teal-2) 35%,var(--teal) 100%);
  box-shadow:inset 0 -40px 60px -30px rgba(10,50,48,.45);transform:translate3d(calc(var(--mx,0)*-14px),calc(var(--my,0)*-8px),0);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.hero-arch::before{content:"";position:absolute;inset:-5.5% -9% 0;border:2px solid var(--teal);border-bottom:0;border-radius:999px 999px 0 0;opacity:.7}
.hero-arch::after{content:"";position:absolute;left:50%;top:13%;width:44%;aspect-ratio:2/1;transform:translateX(-50%);border-radius:999px 999px 0 0;background:radial-gradient(circle at 50% 100%,rgba(242,169,59,.95) 0 38%,rgba(242,169,59,0) 39%),repeating-conic-gradient(from -90deg at 50% 100%,rgba(255,236,200,.55) 0 2deg,transparent 2deg 15deg);opacity:.9}
/* arch v2: a living sunrise over the sea */
.hero-arch{background:none!important;box-shadow:none!important}
.hero-arch::after{content:none!important}
.hero-arch .arch-in{position:absolute;inset:0;border-radius:999px 999px 0 0;overflow:hidden;box-shadow:inset 0 -40px 60px -30px rgba(10,50,48,.45);isolation:isolate}
.hero-arch .arch-in::after{content:"";position:absolute;inset:0;border-radius:inherit;box-shadow:inset 0 0 0 1px rgba(255,255,255,.12),inset 0 -50px 70px -40px rgba(6,40,38,.55);pointer-events:none}
.arch-scene{position:absolute;inset:0;width:100%;height:100%;display:block}
.arch-scene .a-sun{animation:a-rise 40s ease-in-out infinite alternate}
.arch-scene .a-glow{transform-box:fill-box;transform-origin:center;animation:a-breathe 14s ease-in-out infinite}
.arch-scene .a-rays{transform-box:view-box;transform-origin:180px 150px;animation:a-spin 240s linear infinite}
.arch-scene .ar{transform-box:view-box;transform-origin:180px 150px;animation:a-ray 9s ease-in-out infinite;animation-delay:calc(var(--i)*-.6s)}
.arch-scene .a-cloud{opacity:var(--o);animation:a-drift calc(var(--s) * 3) linear infinite}
.arch-scene .a-birds{animation:a-fly 70s ease-in-out infinite alternate}
.arch-scene .ab{transform-box:fill-box;transform-origin:center;animation:a-flap 2.2s ease-in-out infinite alternate}
.arch-scene .aw{animation:a-wave calc(var(--s) * 5) linear infinite}
.arch-scene .aw:nth-child(even){animation-direction:reverse}
.arch-scene .ag{transform-box:fill-box;transform-origin:center;animation:a-glint 7s ease-in-out infinite;animation-delay:calc(var(--i)*-.9s)}
@keyframes a-rise{0%{transform:translateY(14px)}100%{transform:translateY(-6px)}}
@keyframes a-breathe{0%,100%{transform:scale(.97);opacity:.85}50%{transform:scale(1.03);opacity:1}}
@keyframes a-spin{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}
@keyframes a-ray{0%,100%{transform:scale(.96);opacity:.7}50%{transform:scale(1.04);opacity:.95}}
@keyframes a-drift{from{transform:translateX(-140px)}to{transform:translateX(380px)}}
@keyframes a-fly{from{transform:translate(0,0)}to{transform:translate(-70px,18px)}}
@keyframes a-flap{from{transform:scaleY(1)}to{transform:scaleY(.35)}}
@keyframes a-wave{from{transform:translateX(0)}to{transform:translateX(-360px)}}
@keyframes a-glint{0%,100%{transform:scaleX(.8);opacity:.45}50%{transform:scaleX(1);opacity:.8}}
@media (prefers-reduced-motion:reduce){.arch-scene *{animation:none!important}}
.hero-cut{position:absolute;left:18.646%;top:39.92%;width:29.79%;height:auto;filter:drop-shadow(18px 10px 18px rgba(20,30,28,.35));transform:translate3d(calc(var(--mx,0)*8px),calc(var(--my,0)*4px),0);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.hero-wall .eyebrow{color:var(--teal)}
.hero-wall h1 em{color:var(--wine)}
.hero-wall .btn-solid{background:var(--teal);border-color:var(--teal)}
.hero-wall .btn-solid:hover{background:var(--wine);border-color:var(--wine)}
.hero-wall .tag{align-items:center}
.hero-wall .tag .live{font:700 10px/1 var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:#fff;background:#E0464B;border-radius:4px;padding:4px 6px}
.hero-wall .tag b{font-size:22px}

/* the room logo */
.hero-room{position:absolute;left:calc(var(--H)*.40);top:calc(var(--H)*.08);width:calc(var(--H)*.31);aspect-ratio:1/1;container-type:inline-size;z-index:1;
  transform:translate3d(calc(var(--mx,0)*18px),calc(var(--my,0)*12px),0);transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.hero-room::before{content:"";position:absolute;inset:-14%;background:radial-gradient(closest-side,rgba(255,246,230,.55),rgba(255,246,230,0));pointer-events:none}
.room3d{--ink:#2B1517;--wine:#561C24;--W:78cqw;--D:53cqw;--H:48cqw;--bw:max(1.5px,.5cqw);--lw:max(1px,.28cqw);
  position:relative;width:100%;aspect-ratio:1/1;perspective:240cqw;perspective-origin:50% 28%;display:grid;place-items:center;direction:ltr;cursor:pointer}
.room3d .rig{position:relative;width:0;height:0;transform-style:preserve-3d;animation:r3-float 9s ease-in-out 7.2s infinite}
.room3d .scene{position:relative;width:0;height:0;transform-style:preserve-3d;transform:rotateX(-20deg) rotateY(-42deg);animation:r3-cam 7.2s cubic-bezier(.45,0,.25,1) both}
.room3d .face{position:absolute;left:0;top:0}
.room3d .back{width:var(--W);height:var(--H);margin:calc(var(--H)/-2) 0 0 calc(var(--W)/-2);transform:translateZ(calc(var(--D)/-2))}
.room3d .left{width:var(--D);height:var(--H);margin:calc(var(--H)/-2) 0 0 calc(var(--D)/-2);transform:translateX(calc(var(--W)/-2)) rotateY(90deg)}
.room3d .floor{width:var(--W);height:var(--D);margin:calc(var(--D)/-2) 0 0 calc(var(--W)/-2);transform:translateY(calc(var(--H)/2)) rotateX(90deg)}
.room3d .panel{position:absolute;inset:0;border:var(--bw) solid var(--ink);overflow:hidden;background:#FBF4EA}
.room3d .left .panel{background:#F4E9DB}
.room3d .left .panel,.room3d .back .panel{transform-origin:50% 100%;animation:r3-wall .9s cubic-bezier(.6,0,.2,1) .45s both}
.room3d .back .panel{animation-delay:.7s}
.room3d .floor .panel{background:#E4D3BD;animation:r3-floor .7s cubic-bezier(.3,1.3,.5,1) both}
/* wordmark: bold grotesk, like Helvetica Bold */
.room3d .word{position:absolute;inset:0;display:flex;align-items:flex-start;justify-content:center;padding-top:1.6cqw;font-family:"Helvetica Neue",Helvetica,"Inter",Arial,sans-serif;font-weight:700;text-transform:uppercase;letter-spacing:-.035em;line-height:.8;color:var(--wine);white-space:nowrap}
.room3d .word i{font-style:normal;display:inline-block;transform-origin:50% 100%;
  animation:r3-letter .6s cubic-bezier(.3,1.4,.5,1) calc(1.35s + var(--i)*.07s) both,r3-wave .7s ease-in-out calc(4.6s + var(--i)*.08s) both}
.room3d .back .word{font-size:25cqw}
.room3d .left .word{font-size:14cqw;padding-top:2cqw}
.room3d .floor .word{align-items:flex-end;padding:0 0 3.2cqw;font-size:6.4cqw;font-weight:700;letter-spacing:.34em;text-indent:.34em;color:var(--ink);animation:r3-type .9s steps(9,end) 2s both}
.room3d .rug{position:absolute;left:21%;right:27%;top:40%;bottom:27%;border-radius:50%;background:var(--mint);border:var(--lw) solid var(--teal);box-shadow:inset 0 0 0 1.4cqw #EAF5F1,inset 0 0 0 calc(1.4cqw + var(--lw)) var(--teal-2);animation:r3-pop .6s cubic-bezier(.3,1.5,.5,1) 1.1s both}
.room3d .frame{position:absolute;left:24%;top:36%;width:26%;height:24%;border:var(--lw) solid var(--ink);background:linear-gradient(160deg,#F7D9A4 0 45%,#E9B36A 45% 62%,#6CC3B6 62%);box-shadow:inset 0 0 0 1cqw #fff;animation:r3-pop .6s cubic-bezier(.3,1.5,.5,1) 2.5s both}
.room3d .pool{position:absolute;left:62%;top:-18%;width:40%;height:60%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,206,110,.75),rgba(255,206,110,0));opacity:0;animation:r3-on 1.2s ease 4.1s both}
.room3d .wglow{position:absolute;left:68%;top:30%;width:30%;height:70%;border-radius:50%;background:radial-gradient(closest-side,rgba(255,206,110,.7),rgba(255,206,110,0));opacity:0;animation:r3-on 1.2s ease 4.1s both}
/* furniture: little CSS boxes standing on the floor */
.room3d .pc{position:absolute;left:0;top:0;transform-style:preserve-3d;transform:translate3d(var(--px),calc(var(--H)/2),var(--pz))}
.room3d .pd{position:absolute;left:0;top:0;transform-style:preserve-3d;animation:r3-drop .85s cubic-bezier(.3,1.45,.5,1) var(--dl) both}
.room3d .bx{position:absolute;left:0;top:0;transform-style:preserve-3d;transform:translate3d(var(--x),calc(var(--h)/-2 - var(--y)),var(--z))}
.room3d .bx>b{position:absolute;left:0;top:0;box-sizing:border-box;border:var(--lw) solid var(--ink);background:var(--c)}
.room3d .bx>.f{width:var(--w);height:var(--h);margin:calc(var(--h)/-2) 0 0 calc(var(--w)/-2);transform:translateZ(calc(var(--d)/2))}
.room3d .bx>.r{width:var(--d);height:var(--h);margin:calc(var(--h)/-2) 0 0 calc(var(--d)/-2);transform:rotateY(90deg) translateZ(calc(var(--w)/2));box-shadow:inset 0 0 0 99cqw rgba(43,21,23,.2)}
.room3d .bx>.t{width:var(--w);height:var(--d);margin:calc(var(--d)/-2) 0 0 calc(var(--w)/-2);transform:rotateX(90deg) translateZ(calc(var(--h)/2));box-shadow:inset 0 0 0 99cqw rgba(255,255,255,.24)}
.room3d .shade3>b{animation:r3-lit 1s ease 4.1s both}
.room3d .leaves{position:absolute;left:0;top:0;transform-style:preserve-3d;transform:translateY(-6cqw)}
.room3d .leaf{position:absolute;left:-6.5cqw;top:-15cqw;width:13cqw;height:15cqw;transform-origin:50% 100%;animation:r3-leaf 4s ease-in-out 3.4s infinite}
.room3d .leaf+.leaf{transform:rotateY(90deg);animation-delay:4.2s}
.room3d .r3-shadow{position:absolute;left:17%;right:17%;top:80%;height:9%;border-radius:50%;background:radial-gradient(closest-side,rgba(43,21,23,.28),rgba(43,21,23,0));animation:r3-on 1s ease .3s both,r3-shadow 9s ease-in-out 7.2s infinite}
/* act 1: build · act 2: lights on, camera glide, letters bow · act 3: hover in the air */
@keyframes r3-cam{0%{transform:rotateX(-32deg) rotateY(-82deg) scale(.82)}45%{transform:rotateX(-20deg) rotateY(-46deg) scale(1)}72%{transform:rotateX(-15deg) rotateY(-28deg) scale(1.02)}100%{transform:rotateX(-20deg) rotateY(-42deg) scale(1)}}
@keyframes r3-floor{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes r3-wall{0%{transform:scaleY(0)}100%{transform:scaleY(1)}}
@keyframes r3-letter{0%{transform:translateY(-140%)}100%{transform:translateY(0)}}
@keyframes r3-wave{0%,100%{scale:1}45%{scale:1 1.18}}
@keyframes r3-type{0%{clip-path:inset(0 100% 0 0)}100%{clip-path:inset(0 0 0 0)}}
@keyframes r3-pop{0%{transform:scale(0)}100%{transform:scale(1)}}
@keyframes r3-drop{0%{translate:0 -34cqw 0;scale:0}1%{translate:0 -34cqw 0;scale:.4}100%{translate:0 0 0;scale:1}}
@keyframes r3-on{0%{opacity:0}100%{opacity:1}}
@keyframes r3-lit{0%{background:var(--c)}35%{background:#FFF3CF}55%{background:var(--c)}100%{background:#FFD27A;box-shadow:0 0 5cqw 1.5cqw rgba(255,200,90,.55)}}
@keyframes r3-leaf{0%,100%{rotate:z -3deg}50%{rotate:z 3deg}}
@keyframes r3-float{0%,100%{translate:0 0;rotate:y 0deg}25%{translate:0 -1.6cqw;rotate:y 5deg}50%{translate:0 -2.6cqw;rotate:y 0deg}75%{translate:0 -1.2cqw;rotate:y -5deg}}
@keyframes r3-shadow{0%,100%{scale:1;opacity:1}50%{scale:.84;opacity:.6}}
@media (prefers-reduced-motion:reduce){.room3d *{animation:none!important;clip-path:none!important}.room3d .pool,.room3d .wglow{opacity:1}.hero-arch,.hero-cut,.hero-room{transform:none!important}}
@media (max-width:1180px){.hero-room{left:calc(var(--H)*.39);width:calc(var(--H)*.28)}}
@media (max-width:860px){
  .hero-img{max-height:none;background-size:100% 100%;background-position:0 0}
  .hero-room{left:44%;top:calc(133vw*.06);width:46%}
}

/* audience photos: polaroid collage + feed ribbon */
#audience{overflow:hidden}
.stats-head{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center}
@media (max-width:860px){.stats-head{grid-template-columns:1fr}}
.stats-head .live{margin-top:14px}
.aud-collage{position:relative;width:min(330px,80vw);height:250px;margin-inline-end:10px}
.pola{position:absolute;margin:0;background:#fff;padding:10px 10px 38px;border-radius:4px;box-shadow:0 22px 40px -22px rgba(60,25,20,.55)}
.pola img{display:block;width:100%;height:100%;object-fit:cover;border-radius:2px}
.pola figcaption{position:absolute;left:0;right:0;bottom:9px;text-align:center;font:400 22px/1 var(--f-script);color:var(--wine)}
:root:lang(fa) .pola figcaption,:root:lang(ar) .pola figcaption,:root:lang(zh) .pola figcaption,:root:lang(ja) .pola figcaption{font:500 14px/1.2 var(--f-body)}
.pola-back{width:150px;height:200px;right:-6px;top:6px;transform:rotate(7deg);padding-bottom:10px}
.pola-front{width:240px;height:240px;left:0;top:0;transform:rotate(-4deg);transition:transform .5s}
.pola-front img{height:192px}
.aud-collage:hover .pola-front{transform:rotate(-1deg) scale(1.03)}
.pola-tape{position:absolute;left:92px;top:-12px;width:70px;height:22px;background:rgba(35,163,153,.55);transform:rotate(-8deg);border-radius:2px}
.feed{margin:56px calc(50% - 50vw) 0;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.feed-track{display:flex;gap:18px;width:max-content;animation:feed-scroll 60s linear infinite;padding:6px 0 10px}
.feed-card{position:relative;margin:0;width:220px;height:280px;flex:none;border-radius:110px 110px 18px 18px;overflow:hidden;box-shadow:0 18px 34px -24px rgba(60,25,20,.6)}
.feed-card img{width:100%;height:100%;object-fit:cover;transition:transform .8s}
.feed-card:hover img{transform:scale(1.07)}
.feed-card figcaption{position:absolute;left:12px;bottom:12px;background:rgba(251,247,241,.92);color:var(--ink);font:500 12px/1 var(--f-body);letter-spacing:.06em;padding:8px 12px;border-radius:999px}

[dir="rtl"] .feed-track{animation-name:feed-scroll-rtl}
@keyframes feed-scroll{to{transform:translateX(-50%)}}
@keyframes feed-scroll-rtl{to{transform:translateX(50%)}}
@media (prefers-reduced-motion:reduce){.feed-track{animation:none}.feed{overflow-x:auto}}
@media (max-width:860px){.aud-collage{margin:10px auto 0;height:240px}.feed-card{width:170px;height:220px}}

/* about: one tall photo, top to bottom */
.about-grid{align-items:stretch}
.about-tall{position:relative;height:100%;min-height:560px;border-radius:999px 999px 22px 22px;overflow:hidden;box-shadow:0 30px 60px -30px rgba(70,30,25,.45)}
.about-tall img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 40%;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
.about-tall:hover img{transform:scale(1.04)}
.about-tall::after{content:"";position:absolute;inset:12px;border:1.5px solid rgba(251,247,241,.7);border-radius:999px 999px 14px 14px;pointer-events:none}
.about-photos{padding-bottom:0}
@media (max-width:820px){.about-tall{min-height:0;aspect-ratio:3/4}}

/* before / after v2: real photos, 6 rooms, tip cards */
.ba-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(20px,5vw,72px);align-items:end;margin-bottom:28px}
.ba-head .lead{margin:0}
.ba-tabs{margin:0 0 18px;gap:10px}
.ba-tabs .chip{padding:11px 18px;font-size:14px;background:var(--paper);border-color:var(--line);color:var(--ink);transition:background .25s,color .25s,border-color .25s}
.ba-tabs .chip:hover{border-color:var(--teal-2)}
.ba{aspect-ratio:16/9;border-radius:26px;background:#d9d2c6}
.ba img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 55%;transition:opacity .35s}
.ba.swap img{opacity:.0}
.ba .lbl{font-weight:500;backdrop-filter:blur(6px)}
.ba .lbl.r{background:var(--teal);color:#fff}
.ba .handle-line{width:3px;margin-left:-1.5px;background:#fff;box-shadow:0 0 18px rgba(0,0,0,.25)}
.ba .knob{width:56px;height:56px;color:var(--teal)}
.ba-note{margin:10px 2px 0;font-size:12px;color:var(--muted)}
.tips-h{font:500 clamp(26px,3vw,36px)/1.15 var(--f-display);margin:56px 0 22px;color:var(--ink)}
.tips-h em{font-family:var(--f-script);font-style:normal;font-size:1.2em;color:var(--wine)}
:root:lang(fa) .tips-h em,:root:lang(ar) .tips-h em,:root:lang(zh) .tips-h em,:root:lang(ja) .tips-h em{font-family:inherit;font-size:1em}
.tips{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px}
.tip{position:relative;background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:26px 22px 24px;display:grid;gap:14px;align-content:start;transition:transform .35s,box-shadow .35s,border-color .35s}
.tip:hover{transform:translateY(-4px);box-shadow:0 24px 40px -28px rgba(60,25,20,.5);border-color:var(--teal-2)}
.tip svg{width:40px;height:40px;color:var(--teal)}
.tip p{margin:0;font-size:16px;line-height:1.5;color:var(--ink)}
.tip-n{position:absolute;top:18px;right:20px;font:400 30px/1 var(--f-num);color:var(--sand)}
[dir="rtl"] .tip-n{right:auto;left:20px}
.tip:nth-child(2){background:var(--mint)}
.tip:nth-child(3){background:var(--teal);border-color:var(--teal)}
.tip:nth-child(3) p,.tip:nth-child(3) svg{color:#fff}
.tip:nth-child(3) .tip-n{color:rgba(255,255,255,.45)}
@media (max-width:980px){.tips{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:760px){.ba-head{grid-template-columns:1fr}.ba{aspect-ratio:4/3}.ba-tabs{flex-wrap:nowrap;overflow-x:auto;padding-bottom:6px;margin-inline:calc(var(--gutter)*-1);padding-inline:var(--gutter);scrollbar-width:none}.ba-tabs .chip{flex:none}}
.ba-tabs .chip[aria-pressed="true"]{background:var(--teal);color:#fff;border-color:var(--teal)}
@media (max-width:480px){.tips{gap:10px}.tip{padding:18px 16px;border-radius:18px}.tip p{font-size:14px}.tip-n{font-size:22px;top:14px;right:14px}.tip svg{width:32px;height:32px}}

/* topics v2: photo arches with pop-out cut-outs */
.topics{gap:22px;perspective:1200px}
.topic{border-radius:28px;padding:0 0 24px;overflow:visible;gap:0;outline:none;transform-style:preserve-3d;
  transform:rotateX(var(--rx,0deg)) rotateY(var(--ry,0deg));transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .5s,border-color .5s}
.topic:hover,.topic:focus-visible,.topic.is-live{box-shadow:0 34px 60px -36px rgba(60,25,20,.55);border-color:var(--teal-2)}
.t-fig{position:relative;margin:0;aspect-ratio:3/4;transform-style:preserve-3d}
.t-fig img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 100%;transform-origin:50% 100%;transition:transform .8s cubic-bezier(.2,.7,.2,1),filter .6s}
.t-bg{clip-path:url(#archClip)}
.t-cut{pointer-events:none;filter:drop-shadow(0 10px 10px rgba(40,20,10,.12));transform:translateZ(1px)}
.t-ring{position:absolute;left:4.5%;right:4.5%;top:27%;bottom:0;border:1.5px solid var(--teal-2);border-bottom:0;border-radius:999px 999px 0 0;opacity:.35;transition:all .6s cubic-bezier(.2,.7,.2,1)}
.topic:hover .t-bg,.topic:focus-visible .t-bg,.topic.is-live .t-bg{transform:scale(1.07);filter:brightness(.9) saturate(1.08) blur(1.2px)}
.topic:hover .t-cut,.topic:focus-visible .t-cut,.topic.is-live .t-cut{transform:translateZ(40px) translateY(-2.5%) scale(1.08);filter:drop-shadow(0 22px 22px rgba(40,20,10,.28))}
.topic:hover .t-ring,.topic:focus-visible .t-ring,.topic.is-live .t-ring{left:1.5%;right:1.5%;top:24%;opacity:1}
.t-body{display:grid;gap:6px;padding:16px 20px 0}
.topic h3{font-size:24px;transition:color .4s}
.topic:hover h3,.topic.is-live h3{color:var(--teal)}
.topic:nth-child(even){background:linear-gradient(180deg,var(--mint),var(--paper) 55%)}
.topics .topic.reveal{transition-delay:calc(var(--d,0)*80ms)}
@media (prefers-reduced-motion:reduce){.topic,.t-fig img,.t-ring{transition:none}.topic{transform:none}}
@media (max-width:440px){.topic{border-radius:24px;padding-top:0}.topics{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.topic h3{font-size:18px}.topic p{font-size:12.5px}.t-body{padding:10px 10px 0}}

/* book section */
.book-sec{position:relative;overflow:hidden;background:radial-gradient(120% 90% at 85% 10%,#6D2932 0,#4A161D 45%,#2E0D12 100%);color:#F5EDE2;padding-block:clamp(72px,10vw,130px)}
.book-sec::before{content:"";position:absolute;right:-12%;top:-30%;width:60%;aspect-ratio:1;border-radius:50%;background:repeating-conic-gradient(from -90deg,rgba(201,164,100,.12) 0 1deg,transparent 1deg 9deg);-webkit-mask:radial-gradient(closest-side,#000 40%,transparent);mask:radial-gradient(closest-side,#000 40%,transparent);pointer-events:none;animation:sun-rot 80s linear infinite}
@keyframes sun-rot{to{transform:rotate(360deg)}}
.book-grid{position:relative;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,.85fr);gap:clamp(32px,6vw,90px);align-items:center}
.book-visual{position:relative}
.book-mock{display:block;width:100%;border-radius:28px;box-shadow:0 50px 90px -40px rgba(0,0,0,.7);transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
.book-visual:hover .book-mock{transform:scale(1.02)}
.book-cover3d{position:absolute;right:-5%;bottom:-8%;width:30%;perspective:900px}
.book-cover3d img{display:block;width:100%;border-radius:3px 8px 8px 3px;box-shadow:inset 8px 0 0 rgba(0,0,0,.25),0 30px 50px -20px rgba(0,0,0,.75);transform:rotateY(-24deg) rotateX(4deg);transform-origin:left center;animation:book-float 6s ease-in-out infinite}
.book-visual:hover .book-cover3d img{animation-play-state:paused;transform:rotateY(-6deg)}
@keyframes book-float{50%{transform:rotateY(-16deg) rotateX(2deg) translateY(-10px)}}
.book-badge{position:absolute;left:22px;top:22px;background:#C9A464;color:#2E0D12;font:600 11px/1 var(--f-body);letter-spacing:.18em;text-transform:uppercase;padding:9px 14px;border-radius:999px}
.book-copy{display:grid;gap:18px}
.book-sec .eyebrow{color:#C9A464}
.book-sec h2{color:#F5EDE2;font-size:clamp(46px,6vw,84px);line-height:1}
.book-sec h2 em{color:#E9C98A;background:none}
.book-sub{font:italic 400 clamp(19px,2vw,24px)/1.3 var(--f-display);color:#E8D8C4;margin:-4px 0 4px}
.book-copy > p:not(.eyebrow):not(.book-sub){color:#D9C7BA;max-width:52ch}
.book-points{list-style:none;margin:6px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.book-points li{border:1px solid rgba(233,201,138,.3);border-radius:18px;padding:16px 14px;display:grid;gap:4px;background:rgba(255,255,255,.04)}
.book-points b{font:400 28px/1 var(--f-num);color:#E9C98A}
.book-points span{font-size:13px;color:#D9C7BA;line-height:1.35}
.book-sec .btn-solid{background:#C9A464;border-color:#C9A464;color:#2E0D12}
.book-sec .btn-solid:hover{background:#E9C98A;border-color:#E9C98A}
.book-sec .btn-ghost{color:#F5EDE2;border-color:rgba(245,237,226,.6)}
.book-sec .btn-ghost:hover{background:#F5EDE2;color:#2E0D12;border-color:#F5EDE2}
[dir="rtl"] .book-cover3d{right:auto;left:-5%}
@media (max-width:900px){.book-grid{grid-template-columns:1fr}.book-cover3d{width:34%;right:-2%}.book-points{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media (max-width:480px){.book-points b{font-size:22px}.book-points span{font-size:12px}.book-points li{padding:12px 10px}}
@media (prefers-reduced-motion:reduce){.book-sec::before,.book-cover3d img{animation:none}}

/* topics v3: one colour for every card, empty-room arches, floating objects */
.topics{counter-reset:tp}
.topic,.topic:nth-child(even){background:var(--paper);border-color:var(--line)}
.topic{position:relative;counter-increment:tp}
.topic::before{content:"0" counter(tp);position:absolute;left:18px;top:14px;z-index:3;font:400 22px/1 var(--f-num);color:var(--sand)}
.topic:hover,.topic:focus-visible{border-color:var(--teal-2);box-shadow:0 34px 60px -36px rgba(60,25,20,.5)}
.topic:hover h3,.topic:focus-visible h3{color:var(--teal)}
.t-ring{opacity:.45}
.topic:hover .t-ring,.topic:focus-visible .t-ring{opacity:1}
.t-bg{filter:none!important;transform:none}
.topic:hover .t-bg,.topic:focus-visible .t-bg{transform:scale(1.03)}
.t-cut{transform:none!important;filter:drop-shadow(0 14px 14px rgba(40,20,10,.22));transition:scale .7s cubic-bezier(.2,.7,.2,1),filter .7s;
  animation:t-float 6s ease-in-out infinite;animation-delay:calc(var(--d,0)*-1.4s)}
.topic:hover .t-cut,.topic:focus-visible .t-cut{scale:1.05;filter:drop-shadow(0 26px 22px rgba(40,20,10,.32))}
@keyframes t-float{0%,100%{translate:0 0}50%{translate:0 -7px}}
.topic:nth-child(2) .t-cut{transform-origin:50% 0;animation:t-swing 5s ease-in-out infinite}
@keyframes t-swing{0%,100%{rotate:-1.6deg}50%{rotate:1.6deg}}
.topic:nth-child(4) .t-cut,.topic:nth-child(3) .t-cut,.topic:nth-child(8) .t-cut{transform-origin:50% 100%;animation:t-sway 7s ease-in-out infinite;animation-delay:calc(var(--d,0)*-1.4s)}
@keyframes t-sway{0%,100%{rotate:-.8deg;translate:0 0}50%{rotate:.8deg;translate:0 -4px}}
@media (prefers-reduced-motion:reduce){.t-cut{animation:none!important}}

/* reels v2: compact cards with real post thumbnails */
.reels{gap:14px;margin-top:40px}
.reels .reel,.reels .reel.feature,.reels .reel:nth-child(2){display:grid;grid-template-columns:96px 1fr;gap:16px;align-items:center;min-height:0;padding:12px 16px 12px 12px;border-radius:20px;background:var(--paper);color:var(--ink);border:1px solid var(--line);transition:transform .35s,box-shadow .35s,border-color .35s}
.reels .reel:hover{transform:translateY(-3px);border-color:var(--teal-2);box-shadow:0 22px 40px -28px rgba(60,25,20,.5)}
.reel-thumb{position:relative;display:block;aspect-ratio:9/16;border-radius:14px;overflow:hidden;background:var(--linen)}
.reel-thumb img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.reel:hover .reel-thumb img{transform:scale(1.06)}
.reels .reel .play,.reels .reel:nth-child(2) .play{position:absolute;left:50%;top:50%;right:auto;transform:translate(-50%,-50%);width:34px;height:34px;border:0;border-radius:50%;background:rgba(255,255,255,.9);color:var(--teal);opacity:1;box-shadow:0 6px 16px rgba(0,0,0,.25)}
.reel-info{display:grid;gap:6px;min-width:0}
.reels .reel .views{font:400 clamp(30px,3vw,40px)/1 var(--f-num);color:var(--wine)}
.reels .reel:nth-child(2) .views{color:var(--teal)}
.reels .reel .views small{font-size:11px;color:var(--muted)}
.reels .reel h3{font-size:18px;line-height:1.25;color:var(--ink)}
.reel-link{font-size:12.5px;color:var(--teal);letter-spacing:.04em}
[dir="rtl"] .reels .reel .play{left:50%;right:auto}
@media (max-width:900px){.reels{grid-template-columns:1fr}}
@media (max-width:560px){.reels .reel,.reels .reel.feature,.reels .reel:nth-child(2){grid-template-columns:78px 1fr;padding:10px 14px 10px 10px}.reels .reel h3{font-size:16px}}

/* feed ribbon: one arch shape for every photo, never stops */
.feed-card,.feed-card:nth-child(n){border-radius:110px 110px 18px 18px;margin-top:0;height:280px}
.feed-track{animation-play-state:running!important}
@media (max-width:860px){.feed-card,.feed-card:nth-child(n){height:220px;border-radius:85px 85px 16px 16px}}

/* studio logo: built part by part */
.lg{width:min(420px,80%);height:auto;display:block;margin-inline:auto;overflow:visible;cursor:pointer}
.lg *{transform-box:fill-box}
.lg-arch{stroke-dasharray:1;stroke-dashoffset:1}
.lg-fill{transform-origin:50% 100%;transform:scaleY(0)}
.lg-ray{stroke-dasharray:1;stroke-dashoffset:1}
.lg-sunwrap{transform:translateY(90px)}
.lg-sun{transform-origin:50% 100%}
.lg-floor{opacity:0}
.lg-tile,.lg-hor{stroke-dasharray:1;stroke-dashoffset:1}
.lg-deco{transform-origin:50% 100%;transform:scaleY(0)}
.lg-base{transform-origin:50% 50%;transform:scaleX(0)}
.lg-name{fill-opacity:0;stroke-dasharray:1;stroke-dashoffset:1}
.lg-int,.lg-by{opacity:0;transform:translateY(14px)}
.lg-rule{stroke-dasharray:1;stroke-dashoffset:1}
.lg.go .lg-base{animation:lg-sx .9s cubic-bezier(.7,0,.2,1) .1s forwards}
.lg.go .lg-a1{animation:lg-draw 1.6s cubic-bezier(.6,0,.2,1) .5s forwards}
.lg.go .lg-a2{animation:lg-draw 1.6s cubic-bezier(.6,0,.2,1) .75s forwards}
.lg.go .lg-deco{animation:lg-sy .7s cubic-bezier(.3,1.4,.5,1) forwards;animation-delay:calc(1.1s + var(--i)*.12s)}
.lg.go .lg-fill{animation:lg-sy 1s cubic-bezier(.7,0,.2,1) 1.9s forwards}
.lg.go .lg-floor{animation:lg-fade .4s ease 2.6s forwards}
.lg.go .lg-hor{animation:lg-draw .6s ease 2.7s forwards}
.lg.go .lg-tile{animation:lg-draw .5s ease forwards;animation-delay:calc(2.8s + var(--i)*.06s)}
.lg.go .lg-sunwrap{animation:lg-rise 1.6s cubic-bezier(.2,.7,.2,1) 3s forwards}
.lg.go .lg-ray{animation:lg-draw .6s ease-out forwards,lg-glow 4s ease-in-out infinite;animation-delay:calc(3.9s + var(--i)*.07s),calc(5s + var(--i)*.2s)}
.lg.go .lg-name{animation:lg-draw 1.8s ease-in-out 4.2s forwards,lg-fillin .9s ease 5.6s forwards}
.lg.go .lg-r1,.lg.go .lg-r2{animation:lg-draw .8s cubic-bezier(.6,0,.2,1) 5.8s forwards}
.lg.go .lg-int{animation:lg-up .8s ease 6s forwards}
.lg.go .lg-by{animation:lg-up .8s ease 6.4s forwards}
@keyframes lg-draw{to{stroke-dashoffset:0}}
@keyframes lg-sx{to{transform:scaleX(1)}}
@keyframes lg-sy{to{transform:scaleY(1)}}
@keyframes lg-fade{to{opacity:1}}
@keyframes lg-rise{to{transform:translateY(0)}}
@keyframes lg-fillin{to{fill-opacity:1;stroke-width:0}}
@keyframes lg-up{to{opacity:1;transform:translateY(0)}}
@keyframes lg-glow{0%,100%{opacity:1}50%{opacity:.45}}
@media (prefers-reduced-motion:reduce){.lg *{animation:none!important;transform:none!important;opacity:1!important;stroke-dashoffset:0!important;fill-opacity:1!important}}

/* audience world map */
.geo{margin-top:56px;background:var(--paper);border:1px solid var(--line);border-radius:32px;padding:clamp(22px,4vw,44px);box-shadow:0 30px 60px -44px rgba(70,30,25,.5)}
.geo-head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:20px;align-items:end}
.geo-head h3{font:500 clamp(28px,3.4vw,44px)/1.1 var(--f-display);margin-top:10px}
.geo-head h3 em{font-family:var(--f-script);font-style:normal;font-size:1.2em;color:var(--wine)}
:root:lang(fa) .geo-head h3 em,:root:lang(ar) .geo-head h3 em,:root:lang(zh) .geo-head h3 em,:root:lang(ja) .geo-head h3 em{font-family:inherit;font-size:1em}
.geo-sub{font-size:14px;color:var(--muted);max-width:28ch;text-align:end}
.geo-map{margin-top:18px}
.geo-map svg{display:block;width:100%;height:auto;overflow:visible}
.geo-pin .spot{fill:var(--c);stroke:#fff;stroke-width:3}
.geo-pin .pc{fill:#fff;font:400 24px/1 var(--f-num)}
@keyframes geo-pulse{0%{transform:scale(1);opacity:.5}100%{transform:scale(3.4);opacity:0}}
.geo-dots{opacity:0;transition:opacity .6s ease}
.geo.go .geo-dots{opacity:1}
.geo-dots circle{fill:#CDBFAE;transform-box:fill-box;transform-origin:center}
.geo-dots g{transition:opacity .35s ease}
.geo-dots g.fill circle{animation:geo-fill .5s cubic-bezier(.3,1.6,.5,1) both}
.geo-dots g.static circle{animation:none;fill:var(--c)}
@keyframes geo-fill{0%{fill:#CDBFAE;transform:scale(1)}45%{fill:var(--c);transform:scale(1.22)}100%{fill:var(--c);transform:scale(1)}}
.geo-map svg[data-active] .geo-dots g:not(.x){opacity:.28}
.geo-map svg[data-active="i"] .geo-dots g[data-r="i"],.geo-map svg[data-active="g"] .geo-dots g[data-r="g"],.geo-map svg[data-active="u"] .geo-dots g[data-r="u"],.geo-map svg[data-active="e"] .geo-dots g[data-r="e"],.geo-map svg[data-active="o"] .geo-dots g[data-r="o"]{opacity:1}
.geo-arcs path{fill:none;stroke:var(--c);stroke-width:1.6;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;opacity:.75}
.geo-arcs path.fly{animation:geo-arc .55s cubic-bezier(.5,0,.3,1) forwards}
@keyframes geo-arc{to{stroke-dashoffset:0}}
.geo-map svg[data-active] .geo-arcs path{opacity:.2;transition:opacity .35s}
.geo-pin{cursor:pointer;opacity:0;transition:opacity .35s ease}
.geo-pin.in{opacity:1}
.geo-pin .spot{transform-box:fill-box;transform-origin:center;transform:scale(0)}
.geo-pin.in .spot{animation:geo-pop .5s cubic-bezier(.3,1.6,.5,1) forwards}
.geo-pin .pulse{fill:var(--c);opacity:0;transform-box:fill-box;transform-origin:center}
.geo-pin.in .pulse{animation:geo-pulse 1.4s ease-out .2s 2}
.geo-pin.on .pulse{animation:geo-pulse 1.4s ease-out infinite}
.geo-pin .lead{stroke:var(--c);stroke-width:1.6;stroke-dasharray:1;stroke-dashoffset:1;fill:none}
.geo-pin.in .lead{animation:geo-arc .4s ease .15s forwards}
.geo-pin .bub-in{transform-box:fill-box;transform-origin:50% 100%;transform:scale(0)}
.geo-pin.in .bub-in{animation:geo-pop .55s cubic-bezier(.3,1.5,.5,1) .3s forwards}
.geo-pin .bub rect{fill:var(--c);filter:drop-shadow(0 8px 10px rgba(40,20,10,.22))}
.geo-pin.on .bub rect{stroke:#fff;stroke-width:3}
.geo-map svg[data-active] .geo-pin:not(.on){opacity:.35}
@keyframes geo-pop{0%{transform:scale(0)}100%{transform:scale(1)}}
.geo-item{opacity:.45;transition:opacity .4s,transform .4s,border-color .3s,box-shadow .3s,background .3s}
.geo-item.in{opacity:1}
@media (prefers-reduced-motion:reduce){.geo-dots,.geo-item{opacity:1!important;transition:none}.geo-arcs path{stroke-dashoffset:0}.geo-pin .spot,.geo-pin .bub-in{transform:none}.geo-pin .lead{stroke-dashoffset:0}.geo-pin .pulse{animation:none!important}}
.geo-legend{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px;margin-top:22px}
.geo-item{position:relative;display:grid;grid-template-columns:auto 1fr;align-items:center;column-gap:10px;row-gap:4px;text-align:start;padding:14px 16px 16px;border-radius:18px;border:1px solid var(--line);background:var(--cream);cursor:pointer;font:inherit;color:var(--ink);transition:border-color .3s,background .3s,transform .3s}
.geo-item .gi-dot{width:12px;height:12px;border-radius:50%;background:var(--c);grid-row:1}
.geo-item b{font:400 30px/1 var(--f-num);color:var(--c)}
.geo-item span:not(.gi-dot){grid-column:1/-1;font-size:14px;color:var(--muted)}
.geo-item i{grid-column:1/-1;height:4px;border-radius:4px;background:rgba(0,0,0,.06);overflow:hidden;margin-top:4px}
.geo-item s{display:block;height:100%;width:var(--w,0%);max-width:100%;background:var(--c);border-radius:4px;transition:width 1.4s cubic-bezier(.2,.7,.2,1)}
.geo-item[aria-selected="true"]{border-color:var(--c);background:var(--paper);transform:translateY(-3px);box-shadow:0 16px 30px -22px rgba(60,25,20,.5)}
@media (max-width:760px){.geo-head{grid-template-columns:1fr}.geo-sub{text-align:start}.geo-legend{grid-template-columns:repeat(2,minmax(0,1fr))}.geo-legend .geo-item:last-child{grid-column:1/-1}.geo-pin .bub,.geo-pin .lead{display:none}.geo-pin .spot{r:11}.geo-pin .pulse{r:11}.geo-dots circle{r:3.6}.geo-map{margin-inline:-8px}}
.geo-note{font-size:12px;color:var(--muted);margin-top:14px}
.geo-item .gi-sub{grid-column:1/-1;font-style:normal;font-size:11.5px;line-height:1.35;color:var(--muted);opacity:.85;margin-top:-2px}
:root:lang(ru) h1 em,:root:lang(ru) h2 em,:root:lang(ru) h3 em{font-family:var(--f-display);font-style:italic;font-size:1em}

/* header logo: draws in, then the sun rises and sets in a slow loop */
.logo .mark.hm{width:56px;height:45px;overflow:visible}
.hm *{transform-box:fill-box}
.hm-arch{stroke-dasharray:1;stroke-dashoffset:1;animation:hm-draw 1.1s cubic-bezier(.6,0,.2,1) .15s forwards}
.hm-a2{animation-delay:.35s}
.hm-base{transform-origin:50% 50%;transform:scaleX(0);animation:hm-sx .6s cubic-bezier(.7,0,.2,1) forwards}
.hm-deco{transform-origin:50% 100%;transform:scaleY(0);animation:hm-sy .5s cubic-bezier(.3,1.4,.5,1) forwards;animation-delay:calc(.6s + var(--i)*.08s)}
.hm-fill{transform-origin:50% 100%;transform:scaleY(0);animation:hm-sy .7s cubic-bezier(.7,0,.2,1) 1.1s forwards}
.hm-floor{opacity:0;animation:hm-fade .4s ease 1.6s forwards}
.hm-sunwrap{transform:translateY(120px);animation:hm-sun 12s cubic-bezier(.45,.05,.55,.95) 1.7s infinite}
.hm-ray{transform-box:view-box;transform-origin:450px 474px;animation:hm-ray 1.8s ease-in-out infinite;animation-delay:calc(var(--i)*-.2s)}
@keyframes hm-draw{to{stroke-dashoffset:0}}
@keyframes hm-sx{to{transform:scaleX(1)}}
@keyframes hm-sy{to{transform:scaleY(1)}}
@keyframes hm-fade{to{opacity:1}}
@keyframes hm-sun{0%{transform:translateY(120px)}28%,55%{transform:translateY(0)}92%,100%{transform:translateY(-300px)}}
@keyframes hm-ray{0%,100%{transform:scale(.72)}50%{transform:scale(1.18)}}
@media (prefers-reduced-motion:reduce){.hm *{animation:none!important;transform:none!important;opacity:1!important;stroke-dashoffset:0!important}}
/* ===== stats v2: count from zero, growth line, readable chips ===== */
.pcard{position:relative;overflow:hidden;isolation:isolate;transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .5s}
.pcard:hover{transform:translateY(-4px);box-shadow:0 24px 50px -28px rgba(43,21,23,.35)}
.pcard>*{position:relative;z-index:1}
.pcard .spark{position:absolute;z-index:0;right:clamp(24px,3vw,36px);left:66%;top:27%;height:26%;width:auto;overflow:visible;pointer-events:none}
.pcard .sp-area{fill:rgba(35,163,153,.10);opacity:0;transition:opacity 1.2s ease 1.4s}
.pcard .sp-line{fill:none;stroke:var(--teal-2);stroke-width:2.5;vector-effect:non-scaling-stroke;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 2.4s cubic-bezier(.3,0,.2,1) .2s}
.pcard .sp-dot{fill:var(--teal-2);opacity:0;transform-box:fill-box;transform-origin:center;transition:opacity .3s 2.5s}
.pcard.go .sp-area{opacity:1}.pcard.go .sp-line{stroke-dashoffset:0}
.pcard.go .sp-dot{opacity:1;animation:sp-pulse 1.8s ease-in-out 2.6s infinite}
.pcard:nth-child(2) .sp-line{stroke:var(--wine)}.pcard:nth-child(2) .sp-dot{fill:var(--wine)}.pcard:nth-child(2) .sp-area{fill:rgba(86,28,36,.07)}
@keyframes sp-pulse{0%,100%{transform:scale(1);opacity:1}50%{transform:scale(1.9);opacity:.45}}
.count{color:var(--ink);text-shadow:0 1px 0 rgba(255,255,255,.6)}
.count-label{font-weight:600;color:var(--teal);letter-spacing:.14em}
.gain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;border-top:0;padding-top:4px;font-size:13px;color:#5A4A47}
.gain>span{display:flex;flex-direction:column;gap:6px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 14px;box-shadow:0 6px 16px -12px rgba(43,21,23,.3)}
.gain>span>span{font-size:12.5px;line-height:1.25;color:#5A4A47;font-weight:500}
.gain b{font:700 clamp(19px,1.8vw,24px)/1 var(--f-body);color:var(--ink);letter-spacing:-.01em}
.gain .g-today{background:linear-gradient(135deg,#E8F6F2,#fff);border-color:rgba(35,163,153,.35)}
.gain .g-today b{color:var(--teal);display:flex;align-items:center;gap:7px}
.gain .g-today b::before{content:"";width:8px;height:8px;border-radius:50%;background:var(--teal-2);box-shadow:0 0 0 0 rgba(35,163,153,.5);animation:g-ping 1.6s ease-out infinite;flex:none}
@keyframes g-ping{0%{box-shadow:0 0 0 0 rgba(35,163,153,.55)}100%{box-shadow:0 0 0 9px rgba(35,163,153,0)}}
.reach{gap:14px;background:none;border:0;border-radius:0;overflow:visible}
.reach>div{position:relative;background:var(--paper)!important;border:1px solid var(--line);border-radius:20px;padding:24px 22px 22px;display:flex;flex-direction:column;overflow:hidden;transition:transform .5s cubic-bezier(.2,.7,.2,1),box-shadow .5s}
.reach>div:hover{transform:translateY(-5px) rotate(-.4deg);box-shadow:0 22px 44px -26px rgba(43,21,23,.35)}
.reach .r-ic{width:30px;height:30px;padding:7px;border-radius:10px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;margin-bottom:14px;box-sizing:content-box}
.reach .r1{--c:var(--wine)}.reach .r2{--c:var(--teal)}.reach .r3{--c:#C7801A}.reach .r4{--c:var(--teal)}
.reach .r-ic{color:var(--c);background:color-mix(in srgb,var(--c) 12%,transparent)}
.reach b{color:var(--c)!important;font-size:clamp(44px,4.8vw,62px)}
.reach span{font-size:14px;color:#5A4A47;font-weight:500}
.reach .r-bar{display:block;margin-top:auto;padding-top:18px;height:5px;box-sizing:content-box;background-clip:content-box}
.reach .r-bar{position:relative}
.reach .r-bar::before{content:"";position:absolute;left:0;right:0;bottom:0;height:5px;border-radius:9px;background:color-mix(in srgb,var(--c) 12%,transparent)}
.reach .r-bar i{position:absolute;left:0;bottom:0;height:5px;border-radius:9px;width:calc(var(--v)*100%);background:var(--c);transform:scaleX(0);transform-origin:left;transition:transform 1.8s cubic-bezier(.3,0,.2,1) .3s}
[dir=rtl] .reach .r-bar i{left:auto;right:0;transform-origin:right}
.reach.go .r-bar i{transform:scaleX(1)}
.reach>div::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,transparent 40%,rgba(255,255,255,.55) 50%,transparent 60%);transform:translateX(-120%);animation:r-shine 7s ease-in-out infinite;animation-delay:calc(var(--k,0)*1.2s + 2s);pointer-events:none}
.reach>div:nth-child(2){--k:1}.reach>div:nth-child(3){--k:2}.reach>div:nth-child(4){--k:3}
@keyframes r-shine{0%,70%{transform:translateX(-120%)}100%{transform:translateX(120%)}}
@media (max-width:820px){.reach{gap:10px}.reach>div{padding:18px 16px}.gain{grid-template-columns:1fr 1fr 1fr;gap:8px}.gain>span{padding:10px}.gain b{font-size:17px}.pcard .spark{left:72%;top:25%;height:18%}}
@media (max-width:420px){.gain{grid-template-columns:1fr 1fr}.gain>span:last-child{grid-column:1/-1}}
@media (prefers-reduced-motion:reduce){.reach>div::after,.gain .g-today b::before,.pcard .sp-dot{animation:none!important}}
/* feed v3: white frame, grayscale until hovered */
.feed-card{border:5px solid #fff;box-sizing:border-box;background:#fff;box-shadow:0 18px 34px -22px rgba(60,25,20,.55),0 0 0 1px rgba(43,21,23,.06)}
.feed-card img{filter:grayscale(1) contrast(1.04);transition:transform .8s,filter .6s ease}
.feed-card:hover img,.feed-card:active img,.feed-card:focus-within img{filter:none}
@media (max-width:860px){.feed-card{border-width:4px}}
.facts.fx-armed b{opacity:0;transform:translateY(8px);transition:opacity .7s ease,transform .7s cubic-bezier(.2,.7,.2,1)}
.facts.fx-armed b.fx-on{opacity:1;transform:none}
.facts b span{font-size:inherit;color:inherit;line-height:inherit}
.facts b .fx-blip{color:var(--teal)}
.facts .fx-post{white-space:pre}
.facts .fx-n{display:inline-block;font-variant-numeric:tabular-nums;min-width:.6em}
.facts .fx-post{display:inline-block;transition:opacity .35s ease,transform .45s cubic-bezier(.3,1.6,.5,1)}
.facts .fx-post.fx-hide{opacity:0;transform:scale(.3)}
.facts .fx-blip{animation:fx-blip .7s ease both;color:var(--teal)}
@keyframes fx-blip{0%{opacity:0;transform:scale(1.7)}25%{opacity:1;transform:scale(1)}40%{opacity:.15}55%{opacity:1}70%{opacity:.25}85%,100%{opacity:1;transform:scale(1)}}
/* book v3: transparent mock-ups, green modern cover */
.book-visual{min-height:clamp(320px,38vw,560px)}
.book-open{display:block;width:92%;margin-top:6%;filter:drop-shadow(0 40px 40px rgba(0,0,0,.35));transform:rotate(-2deg);animation:bk-open 9s ease-in-out infinite;transition:transform 1s cubic-bezier(.2,.7,.2,1)}
.book-closed{position:absolute;right:-2%;bottom:-6%;width:44%;filter:drop-shadow(0 30px 34px rgba(0,0,0,.45));animation:bk-float 6s ease-in-out infinite;transition:transform .9s cubic-bezier(.2,.7,.2,1)}
.book-visual:hover .book-closed{animation-play-state:paused;transform:translateY(-14px) rotate(2deg) scale(1.03)}
.book-visual:hover .book-open{transform:rotate(-1deg) scale(1.02)}
@keyframes bk-float{0%,100%{transform:translateY(0) rotate(0)}50%{transform:translateY(-16px) rotate(1.5deg)}}
@keyframes bk-open{0%,100%{translate:0 0}50%{translate:0 -6px}}
.book-badge{left:2%;top:0;z-index:2}
[dir="rtl"] .book-closed{right:auto;left:-2%}
@media (max-width:900px){.book-closed{width:40%;right:0;bottom:-4%}}
@media (prefers-reduced-motion:reduce){.book-open,.book-closed{animation:none}}
/* launch-list dialog */
.hp{position:absolute!important;left:-9999px!important;width:1px;height:1px;opacity:0}
.launch{border:0;padding:0;border-radius:28px;width:min(520px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;background:#FBF6EE;color:var(--ink);box-shadow:0 40px 90px -30px rgba(30,8,12,.6)}
.launch::backdrop{background:rgba(30,10,14,.55);backdrop-filter:blur(4px)}
.launch[open]{animation:dlg-in .45s cubic-bezier(.2,.8,.2,1)}
@keyframes dlg-in{from{opacity:0;transform:translateY(24px) scale(.97)}}
.launch-close-f{position:absolute;top:12px;right:12px;margin:0;z-index:2}
[dir=rtl] .launch-close-f{right:auto;left:12px}
.launch-x{width:40px;height:40px;border-radius:50%;border:1px solid var(--line);background:#fff;font:400 24px/1 var(--f-body);cursor:pointer;color:var(--ink)}
.launch-body,.launch-done{padding:34px clamp(22px,5vw,40px) 30px;display:grid;gap:12px}
.launch-book{width:92px;justify-self:start;margin:-6px 0 4px;filter:drop-shadow(0 14px 16px rgba(0,0,0,.3));animation:bk-float 6s ease-in-out infinite}
.launch h3{font:500 clamp(26px,4vw,32px)/1.12 var(--f-display);margin:0}
.launch h3 em{font-style:italic;color:var(--wine)}
.launch-p{color:var(--muted);font-size:15px;margin:0 0 6px}
#launchF{display:grid;gap:12px}
#launchF label{display:grid;gap:6px;font-size:13px;color:var(--muted)}
#launchF input{font:inherit;font-size:16px;padding:13px 14px;border:1px solid var(--line);border-radius:12px;background:#fff;color:var(--ink)}
#launchF input:focus{outline:2px solid var(--teal-2);outline-offset:1px;border-color:transparent}
#launchF .btn{justify-self:stretch;justify-content:center}
.launch-note{font-size:12px;color:var(--muted);margin:0;text-align:center}
.launch-done{justify-items:center;text-align:center;padding-top:46px}
.launch-tick{width:72px;height:72px;border-radius:50%;background:var(--teal);display:grid;place-items:center;animation:geo-pop .5s cubic-bezier(.3,1.6,.5,1)}
.launch-tick svg{width:36px;height:36px;fill:none;stroke:#fff;stroke-width:2.6;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:30;stroke-dashoffset:30;animation:tick 0.5s .25s ease forwards}
@keyframes tick{to{stroke-dashoffset:0}}
.btn[disabled]{opacity:.6;pointer-events:none}
#inquiry.flash{animation:form-flash 1.6s ease}
@keyframes form-flash{0%,100%{box-shadow:0 0 0 0 rgba(201,164,100,0)}25%{box-shadow:0 0 0 6px rgba(201,164,100,.55)}}
.sent.ok h3::before{content:"✓ ";color:var(--teal)}
#launchErr a{color:var(--teal);font-weight:600}
.launch form{background:none!important;padding:0!important;border:0!important;box-shadow:none!important;border-radius:0!important;min-height:0}
.launch-close-f{display:block;width:auto}
/* offers v2: two groups, clickable */
.offers-wrap{display:grid;gap:10px}
.offers-h{display:flex;align-items:center;gap:14px;font:600 12px/1 var(--f-body);letter-spacing:.22em;text-transform:uppercase;color:var(--wine);margin:6px 0 2px}
.offers-h::after{content:"";flex:1;height:1px;background:var(--line)}
.offers + .offers-h{margin-top:26px}
button.offer{all:unset;box-sizing:border-box;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:6px 18px;padding:22px 14px;margin:0 -14px;border-bottom:0;cursor:pointer;border-radius:16px;position:relative;transition:background .35s,transform .35s cubic-bezier(.2,.7,.2,1)}
button.offer h3{font:500 26px/1.15 var(--f-display);color:var(--ink);margin:0}
button.offer p{grid-column:1/-1;font-size:15px;color:var(--muted);margin:0;padding-inline-end:90px}
button.offer .enq{position:absolute;inset-inline-end:14px;bottom:20px;font:600 12px/1 var(--f-body);letter-spacing:.14em;text-transform:uppercase;font-style:normal;color:var(--teal);opacity:0;transform:translateX(-6px);transition:opacity .3s,transform .3s}
[dir=rtl] button.offer .enq{transform:translateX(6px)}
button.offer .enq::after{content:" →"}
[dir=rtl] button.offer .enq::after{content:" ←"}
button.offer:hover,button.offer:focus-visible{background:rgba(255,255,255,.55)}
button.offer:hover .enq,button.offer:focus-visible .enq{opacity:1;transform:none}
button.offer:focus-visible{outline:2px solid var(--teal-2)}
button.offer.svc h3::before{content:"";display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--teal-2);margin-inline-end:12px;vertical-align:middle;position:relative;top:-3px}
@media (hover:none){button.offer .enq{opacity:1;transform:none}}
@media (max-width:600px){button.offer{grid-template-columns:1fr}button.offer p{padding-inline-end:0;padding-bottom:22px}button.offer span{justify-self:start}}
button.offer::after{content:"";position:absolute;left:14px;right:14px;bottom:0;height:1px;background:var(--line)}
.offers{border-top:0}
footer .credit{flex-basis:100%;margin:6px 0 0;padding-top:16px;border-top:1px solid var(--line);font-size:12px;letter-spacing:.06em;color:var(--muted);text-align:center}
footer .credit b{font-weight:600;color:var(--wine);letter-spacing:.08em}
@media (max-width:760px){footer{padding-bottom:96px}}
/* FAQ */
.faq{padding-block:clamp(64px,8vw,110px)}
.faq-grid{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);gap:clamp(28px,6vw,90px);align-items:start}
.faq h2 em{font-family:var(--f-script);font-style:normal;color:var(--wine);font-size:1.15em}
:root:lang(fa) .faq h2 em,:root:lang(ar) .faq h2 em,:root:lang(zh) .faq h2 em,:root:lang(ja) .faq h2 em{font-family:inherit;font-size:1em}
.faq-list{border-top:1px solid var(--line)}
.faq-item{border-bottom:1px solid var(--line)}
.faq-item summary{list-style:none;cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:18px;padding:22px 0}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item h3{font:500 clamp(19px,2vw,23px)/1.3 var(--f-display);margin:0}
.faq-ic{flex:none;width:30px;height:30px;border-radius:50%;border:1px solid var(--line);position:relative;transition:transform .35s,background .35s}
.faq-ic::before,.faq-ic::after{content:"";position:absolute;left:50%;top:50%;width:12px;height:1.6px;background:var(--wine);transform:translate(-50%,-50%)}
.faq-ic::after{transform:translate(-50%,-50%) rotate(90deg);transition:transform .35s}
.faq-item[open] .faq-ic{background:var(--wine)}
.faq-item[open] .faq-ic::before,.faq-item[open] .faq-ic::after{background:#fff}
.faq-item[open] .faq-ic::after{transform:translate(-50%,-50%) rotate(0)}
.faq-item p{margin:0;padding:0 48px 24px 0;color:var(--muted);font-size:16px;line-height:1.65}
[dir=rtl] .faq-item p{padding:0 0 24px 48px}
@media (max-width:860px){.faq-grid{grid-template-columns:1fr}.faq-item p{padding-inline-end:0}}
html:not(.ready) .hero *,html:not(.ready) .hero *::before,html:not(.ready) .hero *::after,html:not(.ready) .logo *{animation-play-state:paused!important}
.hero-wall .tag .live{background:#B8323A}
.band button.offer span{color:#155A56}
.band button.offer p,.band .lead{color:#5A463F}
button.offer{margin:0!important}
.stats-head .eyebrow,.band .eyebrow{color:#155A56}
.stats-head .live,.stats-head .live span{color:#5A463F}
/* the page never becomes wider than the phone and cannot be pinched smaller */
html{overflow-x:hidden}
body{max-width:100%;overflow-x:clip}
html{touch-action:pan-x pan-y}
.mk-dl{margin-top:26px;display:inline-flex;align-items:center;gap:10px}
.mk-dl svg{width:20px;height:20px}
/* far-away sections are skipped until needed (switched off before any jump link so it lands exactly) */
html:not(.cv-off) main>section:not(.hero),html:not(.cv-off) footer{content-visibility:auto;contain-intrinsic-size:auto 900px}
.gain .g-today{display:none!important}
.gain{grid-template-columns:repeat(2,minmax(0,1fr))!important}.gain>span:last-child{grid-column:auto!important}
.lang-hint{position:absolute;top:calc(100% + 10px);right:0;display:flex;align-items:center;gap:7px;padding:7px 12px;border-radius:999px;background:var(--wine);color:#fff;font:500 13px/1 var(--f-body);white-space:nowrap;box-shadow:0 10px 24px -12px rgba(70,30,25,.6);opacity:0;transform:translateY(-4px);transition:opacity .5s ease,transform .5s ease;pointer-events:none;z-index:39;min-width:104px;justify-content:center}
[dir="rtl"] .lang-hint{right:auto;left:0}
.lang-hint::before{content:"";position:absolute;top:-5px;right:22px;width:10px;height:10px;background:var(--wine);transform:rotate(45deg);border-radius:2px}
[dir="rtl"] .lang-hint::before{right:auto;left:22px}
.lang-hint.on{opacity:1;transform:none}
.lang-hint svg{width:14px;height:14px;flex:none;opacity:.85}
.lang-hint .lh-w{display:inline-block;min-width:60px;text-align:center}
.lang-hint .lh-w.in{animation:lh-in .45s ease both}
@keyframes lh-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.nav-links a,.nav .btn{white-space:nowrap}
.offer+.offer{margin-top:6px}
.ck{position:fixed;left:16px;bottom:16px;z-index:60;max-width:360px;background:var(--paper);color:var(--ink);border:1px solid var(--line);border-radius:16px;padding:14px 16px;box-shadow:0 20px 40px -20px rgba(70,30,25,.45);font:400 13.5px/1.45 var(--f-body);opacity:0;transform:translateY(10px);transition:opacity .4s,transform .4s}
[dir="rtl"] .ck{left:auto;right:16px}
.ck.on{opacity:1;transform:none}
.ck p{margin:0 0 10px}
.ck div{display:flex;gap:8px;justify-content:flex-end}
.ck button{font:500 13px/1 var(--f-body);border-radius:999px;padding:9px 16px;cursor:pointer;border:1px solid var(--line);background:transparent;color:var(--ink)}
.ck .ck-ok{background:var(--wine);border-color:var(--wine);color:#fff}
@media (max-width:520px){.ck{left:12px;right:84px;bottom:12px;max-width:none}[dir="rtl"] .ck{left:84px;right:12px}}
.launch .consent{display:flex!important;flex-direction:row!important;gap:10px;align-items:flex-start;font:400 13px/1.45 var(--f-body)!important;text-transform:none!important;letter-spacing:0!important;color:var(--muted)!important;text-align:start;margin:4px 0 2px;cursor:pointer}
.launch .consent input{width:18px!important;height:18px!important;min-height:0!important;padding:0!important;border-radius:4px!important;flex:none;margin:1px 0 0!important;accent-color:var(--wine)}
.launch .consent a{color:var(--wine)}
.chart{position:relative;border-radius:16px;padding:12px 14px 10px;background:radial-gradient(120% 140% at 100% 0%,#3a1c22 0%,#1d0f12 55%,#160a0d 100%);color:#e9f7f5;box-shadow:inset 0 0 0 1px rgba(255,255,255,.06),0 14px 30px -18px rgba(20,6,9,.7);overflow:hidden;--neon:#3fe0d0;--neon-a:rgba(63,224,208,.32)}
.chart[data-p="fb"]{--neon:#ff8fa3;--neon-a:rgba(255,143,163,.30)}
.ch-head{display:flex;justify-content:space-between;align-items:center;font:500 11px/1 var(--f-body);letter-spacing:.14em;text-transform:uppercase;color:rgba(233,247,245,.62);margin-bottom:8px}
.ch-pct{font:700 12px/1 var(--f-body);letter-spacing:.02em;color:var(--neon);background:rgba(255,255,255,.06);border:1px solid var(--neon-a);border-radius:999px;padding:5px 9px;text-shadow:0 0 10px var(--neon-a)}
.ch-plot{position:relative;height:clamp(86px,9vw,112px)}
.ch-plot svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
.ch-grid path{stroke:rgba(255,255,255,.07);stroke-width:1;vector-effect:non-scaling-stroke;stroke-dasharray:2 4}
.ch-s1{stop-color:var(--neon);stop-opacity:.38}.ch-s2{stop-color:var(--neon);stop-opacity:0}
.ch-area{opacity:0;transition:opacity 1.2s ease 1.2s}
.ch-glow{fill:none;stroke:var(--neon);stroke-width:9;opacity:.16;vector-effect:non-scaling-stroke;stroke-linecap:round}
.ch-line{fill:none;stroke:var(--neon);stroke-width:2.4;vector-effect:non-scaling-stroke;stroke-linecap:round;stroke-dasharray:1;stroke-dashoffset:1;transition:stroke-dashoffset 2.2s cubic-bezier(.3,0,.2,1) .2s}
.ch-dot{position:absolute;right:-5px;width:10px;height:10px;margin-top:-5px;border-radius:50%;background:var(--neon);box-shadow:0 0 0 3px rgba(255,255,255,.12),0 0 14px 2px var(--neon);opacity:0;transition:opacity .4s 2.3s}
.ch-dot::after{content:"";position:absolute;inset:-6px;border-radius:50%;border:1.5px solid var(--neon);opacity:0}
.ch-scan{position:absolute;top:0;bottom:0;left:0;width:38%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.07) 80%,var(--neon-a) 99%,transparent);opacity:0;transform:translateX(-100%);pointer-events:none}
.ch-axis{display:flex;justify-content:space-between;margin-top:7px;font:500 10.5px/1 var(--f-body);letter-spacing:.12em;text-transform:uppercase;color:rgba(233,247,245,.5)}
.pcard.go .ch-area{opacity:1}.pcard.go .ch-line{stroke-dashoffset:0}.pcard.go .ch-dot{opacity:1}
.pcard.go .ch-dot::after{animation:ch-ping 2.2s ease-out 2.6s infinite}
.pcard.go .ch-scan{animation:ch-scan 5.5s cubic-bezier(.45,0,.55,1) 2.8s infinite}
@keyframes ch-ping{0%{transform:scale(.6);opacity:.9}100%{transform:scale(2.2);opacity:0}}
@keyframes ch-scan{0%{transform:translateX(-100%);opacity:0}15%{opacity:1}85%{opacity:1}100%{transform:translateX(265%);opacity:0}}
@media (prefers-reduced-motion:reduce){.ch-scan,.ch-dot::after{animation:none!important;display:none}}
</style>

